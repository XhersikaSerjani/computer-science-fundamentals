#simulation of saving money over time.

annual_salary = float(input ("Enter your annual salery:"))
cost = float(input("Enter the price of the item you would like to purchase:"))
percent_saved = float(input ("Please enter the percent of salary to save each month (as a decimal) :"))

annual_return = 0.04
monthly_return = annual_return / 12

current_savings = 0
months = 0

monthly_saving = (annual_salary / 12) * percent_saved


while current_savings < cost:
    current_savings += monthly_saving + current_savings * monthly_return
    months += 1
    if months % 6 == 0:
      annual_salary *= 1.06
      monthly_saving = (annual_salary / 12) * percent_saved


print ("Number of months needed to save enough :", months)
