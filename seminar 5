# the system fails because the floating-point precision error. computer work with binary numbers the 0.1 should be in a binary form but we can not represent it in such format. so instead of storing exactly 0.1 , the computer stores a very close approximation. so when we add this approximation 10 , the small errors acucumulate and give us a outcome of 0.999... there for even if mathematically is possible we can not write it in a program from.

print("=== Mission 2 & 3: Bisection Method ===")

shield_frequency = 150
epsilon = 0.05

low = 0.0
high = shield_frequency
guess = (low + high) / 2.0

num_guesses = 0
max_guesses = 10000

# Bisection loop
while abs(guess**3 - shield_frequency) >= epsilon and num_guesses < max_guesses:
    if guess**3 < shield_frequency:
        low = guess
    else:
        high = guess
    
    guess = (low + high) / 2.0
    num_guesses += 1

# Final result (Mission 2 + Mission 3 behavior)
if abs(guess**3 - shield_frequency) < epsilon:
    print("Laser locked!")
    print("ASTEROID DESTROYED!")
