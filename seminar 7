#2.3 "Damped" Newton-Raphson (Business Logic)
def f(v):
    return v**3 - 5*v - 9

def f_derivative(v):
    return 3*v**2 - 5 #Derivative of function

def find_v_newton(guess, tolerance): #guess = starting value, tolerance = accuracy
    v = guess #Start from initial guess
    iterations = 0 #Count steps

    while True: #Loop until we stop manually
        if abs(f(v)) <= tolerance: #Stop when close to 0
            print("Iterations:", iterations) #Print steps
            return v #Return root

        v = v - 0.85 * (f(v) / f_derivative(v)) #Derivative of function where f(v) is function value, f_derivative(v) is slope and 0.85 is damping (slows movement)
        iterations += 1 #Count iteration

# User inputs values
guess = float(input("Enter initial guess: "))
tolerance = float(input("Enter tolerance: "))

# Call function
root = find_v_newton(guess, tolerance)
print("Root (Newton):", root) #Print result

