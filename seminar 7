#WITH USER INPUT
#Sensor Data Validation 
def parse_sensor_data(user_input): # the user_input gets the data by the user and put it in our function
    device_id = "" #it create a empty string that the letters will be stored 
    error_sum = 0 # it will store the sum of all numbers found
    for i in range(len(user_input)): #loops through the string using index positions 
        char = user_input[i] #checks the char using positions
        
        if char.isalpha(): # checks if the char is a letter a-z
            device_id = device_id + char.upper() # it converts the letters in uppercase  and add them to device_id
            
        elif char.isdigit(): #checks it the char is a number 0-9
            num = int(char) # converts the char that is a string into an integer
            error_sum = error_sum + num #adds the numbers to total sum
            print ("[Audit] Number detected:", num , "| Current Sum:",error_sum)#prints message every time a number is found 
            
    return device_id , error_sum #returns 2 values the final string of letters from the device_id and the total sum of nr from error_sum
    
user_input = input ("Enter sensor data:") #data is input by the user 
device_id, error_sum = parse_sensor_data(user_input)
print ("Device ID:",device_id)
print ("Error Sum:",error_sum)

