def f(v): #Defines the function 
    return v**3 - 5*v - 9  

def find_v_guess(target_error): #Function that finds root,target_error how close to 0 we want
    v = 2.0 # Start from 2 (given interval)
    step = 0.001 #Increase value slowly by 0.001
    guesses = 0 #Counts how many tries

    while v <= 3: #Loop until we reach 3
        guesses += 1 #Add 1 guess each loop
