#2.2 Bisection Method
def f(v):
    return v**3 - 5*v - 9

def find_v_bisection(low, high, tolerance): # low = start (2), high = end (3), tolerance = accuracy
    steps = 0 #Count iterations

    while (high - low) / 2 > tolerance: #Continue until interval is small enough
        mid = (low + high) / 2 #Find middle point
        steps += 1 #Count step

        if f(mid) == 0: #Exact root found
            print("Steps:", steps) #Print steps
            return mid #Return value

        elif f(low) * f(mid) < 0: #Check sign change, Root is between low and mid
            high = mid #Move right boundary
        else:
            low = mid #Otherwise root is on other side

    print("Steps:", steps)
    return (low + high) / 2 #Return final approximation

